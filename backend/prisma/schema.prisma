generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PARENT
  DOCTOR
  CAREGIVER
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName     String    @map("full_name")
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(PARENT)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  babies             Baby[]
  caregiverMappings  Caregiver[]           @relation("CaregiverUser")
  invitedCaregivers  Caregiver[]           @relation("CaregiverInvitedBy")
  acknowledgedAlerts Alert[]               @relation("AlertAcknowledgedBy")
  notifications      NotificationHistory[]
  auditLogs          AuditLog[]
  invitations        Invitation[]          @relation("UserInvitations")

  @@map("users")
}

model Baby {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId    String    @map("parent_id") @db.Uuid
  name        String
  birthDate   DateTime  @map("birth_date") @db.Date
  gender      String
  bloodGroup  String?   @map("blood_group")
  birthWeight Float?    @map("birth_weight")
  birthHeight Float?    @map("birth_height")
  photoUrl    String?   @map("photo_url")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  parent            User               @relation(fields: [parentId], references: [id], onDelete: Cascade)
  deviceAssignments DeviceAssignment[]
  caregivers        Caregiver[]
  cradles           Cradle[]
  alerts            Alert[]
  aiReports         AiReport[]
  sleepSessions     SleepSession[]
  invitations       Invitation[]

  @@map("babies")
}

model Cradle {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serialNumber String   @unique @map("serial_number")
  firmware     String?
  babyId       String   @map("baby_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  baby Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)

  @@map("cradles")
}

model Device {
  deviceId        String   @id @map("device_id") @db.VarChar(100)
  deviceName      String   @map("device_name")
  type            String   // 'hub', 'sock', 'camera', 'environmental'
  firmwareVersion String   @map("firmware_version") @db.VarChar(50)
  protocol        String   @db.VarChar(50) // 'BLE', 'Wi-Fi'
  battery         Int?
  paired          Boolean  @default(false)
  lastSeen        DateTime @default(now()) @map("last_seen") @db.Timestamptz
  status          String   @default("offline") @db.VarChar(50) // 'online', 'offline', 'error'

  assignments DeviceAssignment[]

  @@map("devices")
}

model DeviceAssignment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId   String   @map("device_id") @db.VarChar(100)
  babyId     String   @map("baby_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  device Device @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
  baby   Baby   @relation(fields: [babyId], references: [id], onDelete: Cascade)

  @@unique([deviceId, babyId])
  @@map("device_assignments")
}

model Caregiver {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  babyId      String   @map("baby_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  accessLevel String   @default("monitor") @map("access_level") @db.VarChar(50) // 'view-only', 'monitor', 'manage'
  status      String   @default("pending") @db.VarChar(50) // 'pending', 'accepted'
  invitedBy   String   @map("invited_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  baby    Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)
  user    User @relation("CaregiverUser", fields: [userId], references: [id], onDelete: Cascade)
  inviter User @relation("CaregiverInvitedBy", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([babyId, userId])
  @@map("caregivers")
}

model Telemetry {
  id               String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId         String   @map("device_id") @db.VarChar(100)
  babyId           String?  @map("baby_id") @db.Uuid
  timestamp        DateTime @db.Timestamptz
  heartRate        Int?     @map("heart_rate")
  respirationRate  Int?     @map("respiration_rate")
  bodyTemperature  Float?   @map("body_temperature")
  roomTemperature  Float?   @map("room_temperature")
  humidity         Float?
  movementDetected Boolean? @map("movement_detected")
  cryDetected      Boolean? @map("cry_detected")
  sleepStage       String?  @map("sleep_stage") @db.VarChar(50)
  airQuality       Int?     @map("air_quality")
  batteryLevel     Int?     @map("battery_level")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([id, timestamp])
  @@index([deviceId, timestamp(desc)])
  @@index([babyId, timestamp(desc)])
  @@map("telemetry")
}

model Alert {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId       String    @map("device_id") @db.VarChar(100)
  babyId         String?   @map("baby_id") @db.Uuid
  severity       String    @db.VarChar(50) // 'warning', 'danger', 'emergency'
  type           String    @db.VarChar(100) // 'high_fever', 'apnea', 'unsafe_posture', etc.
  message        String
  value          Float?
  thresholdLimit Float?    @map("threshold_limit")
  timestamp      DateTime  @default(now()) @db.Timestamptz
  acknowledged   Boolean   @default(false)
  acknowledgedBy String?   @map("acknowledged_by") @db.Uuid
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz

  baby            Baby?                 @relation(fields: [babyId], references: [id], onDelete: Cascade)
  acknowledgedUser User?                @relation("AlertAcknowledgedBy", fields: [acknowledgedBy], references: [id], onDelete: SetNull)
  notifications   NotificationHistory[]

  @@map("alerts")
}

model NotificationHistory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  alertId    String?  @map("alert_id") @db.Uuid
  title      String   @db.VarChar(255)
  message    String
  status     String   @default("sent") @db.VarChar(50) // 'sent', 'failed', 'retrying'
  sentAt     DateTime @default(now()) @map("sent_at") @db.Timestamptz
  retryCount Int      @default(0) @map("retry_count")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert Alert? @relation(fields: [alertId], references: [id], onDelete: SetNull)

  @@map("notification_history")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String   @db.VarChar(255)
  targetTable String?  @map("target_table") @db.VarChar(100)
  targetId    String?  @map("target_id") @db.Uuid
  details     String?
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  timestamp   DateTime @default(now()) @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model AiReport {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  babyId          String   @map("baby_id") @db.Uuid
  reportType      String   @map("report_type") @db.VarChar(50) // 'daily', 'weekly', 'monthly'
  summary         String
  keyFindings     Json     @default("{}") @map("key_findings")
  recommendations String
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime @map("end_date") @db.Date
  generatedAt     DateTime @default(now()) @map("generated_at") @db.Timestamptz

  baby Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)

  @@map("ai_reports")
}

model SleepSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  babyId     String   @map("baby_id") @db.Uuid
  startTime  DateTime @map("start_time") @db.Timestamptz
  endTime    DateTime? @map("end_time") @db.Timestamptz
  sleepScore Int?     @map("sleep_score")
  notes      String?

  baby        Baby         @relation(fields: [babyId], references: [id], onDelete: Cascade)
  sleepStages SleepStage[]

  @@map("sleep_sessions")
}

model SleepStage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  startTime DateTime @map("start_time") @db.Timestamptz
  endTime   DateTime @map("end_time") @db.Timestamptz
  stage     String   // 'awake', 'light', 'deep', 'rem'

  session SleepSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("sleep_stages")
}

model Invitation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  babyId     String   @map("baby_id") @db.Uuid
  email      String   @db.VarChar(255)
  role       String   @db.VarChar(50) // 'SECONDARY_PARENT', 'GRANDPARENT', 'BABYSITTER'
  token      String   @unique @db.VarChar(255)
  status     String   @default("PENDING") @db.VarChar(50) // 'PENDING', 'ACCEPTED', 'REJECTED', 'EXPIRED'
  invitedBy  String   @map("invited_by") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  baby Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)
  inviter User @relation("UserInvitations", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@map("invitations")
}
