# Database Connection URL (PostgreSQL)
# Example: postgresql://username:password@localhost:5432/maatriva?schema=public
DATABASE_URL=

# JWT Signing Secret (Generate a secure cryptographically random string for production)
JWT_SECRET=

# Server Configuration
PORT=3000
HOST=0.0.0.0
# Environment: 'development', 'test', or 'production' (Production disables all debug routes)
NODE_ENV=development
# Debug routes (/debug/*) are ONLY mounted when NODE_ENV is development AND DEBUG_MODE=true.
# Safe default: false (ALWAYS false in production)
DEBUG_MODE=false

# CORS Allowlist (Comma-separated list of approved frontend origins)
# Example: http://localhost:3000,http://localhost:5173,https://app.maatriva.co.in
CORS_ORIGINS=

# API & Auth Rate Limiting (Optional overrides)
# API_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=15

# Request Body & Upload Payload Limits
# JSON_BODY_LIMIT=2mb
# URLENCODED_BODY_LIMIT=2mb
# MAX_AUDIO_UPLOAD_MB=10
# MAX_MUSIC_UPLOAD_MB=15
# MAX_IMAGE_UPLOAD_MB=5
# TRUST_PROXY=true

# MQTT Settings (Optional)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=MaatrivaBackendServer
MQTT_USERNAME=
MQTT_PASSWORD=

# Gemini AI API Key (Optional)
GEMINI_API_KEY=

# First-Run Admin Seeding (Used only when running: npm run seed:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

